{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=home4paws_dev;Username=postgres;Password=password;Port=5432"
  },
  "JwtSettings": {
    "SecretKey": "Home4Paws-Development-Secret-Key-Must-Be-At-Least-32-Characters-Long",
    "Issuer": "Home4Paws-Dev",
    "Audience": "Home4Paws-Users-Dev",
    "ExpiryInMinutes": 60
  },
  "ExternalServices": {
    "CloudinaryUrl": "cloudinary://dev-key:dev-secret@dev-cloud-name",
    "GoogleMapsApiKey": "dev-google-maps-api-key",
    "OpenAIApiKey": "dev-openai-api-key",
    "BaseUrl": "http://localhost:5000"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  },
  "Features": {
    "EnableSwagger": true,
    "EnableDetailedErrors": true,
    "EnableChatbot": true,
    "EnableFileUpload": true
  }
}
