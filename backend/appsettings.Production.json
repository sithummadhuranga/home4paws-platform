{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=prod-db-host;Database=home4paws_prod;Username=prod_user;Password=prod_password;Port=5432;SSL Mode=Require"
  },
  "JwtSettings": {
    "SecretKey": "Home4Paws-Production-Super-Secret-Key-Must-Be-Very-Long-And-Secure-For-Production-Use",
    "Issuer": "Home4Paws-Production",
    "Audience": "Home4Paws-Users-Production",
    "ExpiryInMinutes": 30
  },
  "ExternalServices": {
    "CloudinaryUrl": "cloudinary://prod-key:prod-secret@prod-cloud-name",
    "GoogleMapsApiKey": "prod-google-maps-api-key",
    "OpenAIApiKey": "prod-openai-api-key",
    "BaseUrl": "https://home4paws-api.railway.app"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://home4paws.vercel.app",
      "https://home4paws-platform.vercel.app"
    ]
  },
  "Features": {
    "EnableSwagger": false,
    "EnableDetailedErrors": false,
    "EnableChatbot": true,
    "EnableFileUpload": true
  }
}
